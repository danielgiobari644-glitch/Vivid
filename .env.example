# ============================================================
# GIODAI - Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ---- Firebase Admin SDK (for backend) ----
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=giodai
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@giodai.iam.gserviceaccount.com
FIREBASE_WEB_API_KEY=AIzaSyCsYhrSKrCRfxGnsx7NHNESalMc4fEUiTU

# ---- Backend Configuration ----
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","https://your-netlify-site.netlify.app"]

# ---- Rendering Settings ----
DEFAULT_FPS=30
MAX_RENDER_DURATION=300
MAX_FILE_SIZE=52428800